# Copy this file to sdfcc-database.secret.yaml, replace every CHANGE_ME value,
# encrypt it with SOPS, and commit only sdfcc-database.secret.sops.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: sdfcc-database
  namespace: sdfcc-dev
type: Opaque
stringData:
  POSTGRES_DB: sdfcc
  POSTGRES_USER: sdfcc_app
  POSTGRES_PASSWORD: CHANGE_ME
  SPRING_DATASOURCE_URL: jdbc:postgresql://postgresql.sdfcc-dev.svc.cluster.local:5432/sdfcc
  SPRING_DATASOURCE_USERNAME: sdfcc_app
  SPRING_DATASOURCE_PASSWORD: CHANGE_ME
